# An install's settings. Copy this file to .env next to compose.yaml and fill it in; the server
# CLI (#8) will write it instead. Lines starting with "# SC_" show a default you may change.

# The domain the business points at this server. Caddy obtains its certificate (SEC-8).
SC_DOMAIN=

# Postgres's password: long and random, for example from `openssl rand -hex 32`.
SC_POSTGRES_PASSWORD=

# Ports Caddy publishes, the only published ports (SEC-14).
# SC_HTTP_PORT=80
# SC_HTTPS_PORT=443

# Leave production, unless this is a development stack: it turns on the API's documentation.
# SC_ENVIRONMENT=production

# The local models the vendor sets (ADR-0030). Changing the embedding model is a re-index (KB-14).
# SC_EMBEDDING_MODEL=BAAI/bge-m3
# SC_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# TEI's image tag: an ARM64 server sets cpu-arm64-1.9.4 (ADR-0028). Memory limits measured in #4.
# SC_TEI_TAG=cpu-1.9.4
# SC_TEI_MAX_BATCH_TOKENS=2048
# SC_TEI_TOKENIZATION_WORKERS=2

# Where Ollama runs: the install's own container by default.
# SC_OLLAMA_URL=http://ollama:11434

# Seconds before Valkey hands an unfinished job to the worker again; above the longest job
# (OPS-11). A placeholder until the M0 benchmark measures it.
# SC_CELERY_VISIBILITY_TIMEOUT=3600
