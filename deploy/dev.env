# Development values for the compose.yaml at the repository root. Never use them on a server.
SC_VERSION=dev
SC_DOMAIN=localhost
SC_ENVIRONMENT=development
SC_POSTGRES_PASSWORD=development-only
SC_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtb25seS1kZXZlbG9wbWVudC1vbmx5

# Small multilingual models keep the development stack and CI light. Servers default to the
# PRD's first candidates, bge-m3 and bge-reranker-v2-m3.
SC_EMBEDDING_MODEL=intfloat/multilingual-e5-small
SC_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
