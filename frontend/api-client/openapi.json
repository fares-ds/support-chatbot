{
  "openapi": "3.1.0",
  "info": {
    "title": "Support Chatbot API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FullHealthReport"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FullHealthReport"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckStatus": {
        "type": "string",
        "enum": [
          "ok",
          "down"
        ],
        "title": "CheckStatus"
      },
      "FullHealthReport": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckStatus"
            },
            "type": "object",
            "title": "Checks"
          },
          "schema_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema Revision"
          },
          "worker_heartbeat": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Worker Heartbeat"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks",
          "schema_revision",
          "worker_heartbeat"
        ],
        "title": "FullHealthReport"
      },
      "HealthReport": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckStatus"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "HealthReport"
      }
    }
  }
}
